{
  "name": "latte-ts-models",
  "version": "1.0.0",
  "description": "基于 Anthropic SDK 的多 Provider AI 客户端库",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "require": "./dist/index.js",
      "import": "./dist/index.mjs",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "bin": {
    "latte-ts-models": "./dist/cli/index.js"
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "test": "jest",
    "test:watch": "jest --watch",
    "prepublishOnly": "npm run build",
    "build:cli": "tsup cli/index.ts --format cjs --outDir dist/cli",
    "build:ui": "cd ui && npx vite build --outDir ../dist-ui",
    "build:all": "npm run build && npm run build:cli && npm run build:ui",
    "dev:server": "tsx cli/index.ts ui --port 3456",
    "dev:ui": "cd ui && npx vite --port 5173",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:ui\"",
    "test:e2e": "npx playwright test",
    "test:all": "npm run test && npm run test:e2e"
  },
  "keywords": [
    "ai",
    "anthropic",
    "claude",
    "llm",
    "client"
  ],
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@rollup/rollup-darwin-x64": "^4.60.4",
    "commander": "^14.0.3",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "fs-extra": "^11.3.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/fs-extra": "^11.0.4",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "@vitejs/plugin-react": "^4.4.1",
    "concurrently": "^9.1.2",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vite": "^6.3.5"
  }
}
